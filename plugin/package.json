{
    "name": "barrage-plugin",
    "version": "1.0.0",
    "description": "Block Barrage: Canopy plugin for the arcade leaderboard",
    "type": "module",
    "main": "dist/main.js",
    "types": "dist/main.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json && npm run copy:proto",
        "copy:proto": "cp src/proto/index.js src/proto/index.cjs src/proto/index.d.ts dist/proto/",
        "start": "node dist/main.js",
        "build:proto": "pbjs -t static-module -w commonjs -o src/proto/index.js proto/*.proto && pbts -o src/proto/index.d.ts src/proto/index.js && cp src/proto/index.js src/proto/index.cjs",
        "build:descriptors": "node scripts/generate-descriptors.cjs",
        "build:all": "npm run build:proto && npm run build:descriptors && npm run build",
        "test": "npm run build && node --test --test-timeout=60000 --test-reporter=spec 'test/*.test.ts'",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "long": "^5.2.3",
        "protobufjs": "^7.6.6"
    },
    "devDependencies": {
        "@types/node": "^20.19.11",
        "protobufjs-cli": "^1.1.1",
        "typescript": "^5.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}