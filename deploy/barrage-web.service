[Unit]
Description=Block Barrage web (block feed, score relay, static game)
After=network-online.target barrage-game.service

[Service]
User=barrage-web
Group=barrage-web
WorkingDirectory=/opt/barrage/app
Environment=NODE_ENV=production
Environment=CANOPY_RPC=http://127.0.0.1:31002
Environment=PLUGIN_RPC=http://127.0.0.1:31010
Environment=CHAIN_ID=2
Environment=HOST=127.0.0.1
Environment=PORT=8790
# Caddy runs on this machine; the server only believes X-Forwarded-For from loopback
Environment=TRUST_PROXY=1
# signs submit_score. Root-owned on disk; systemd hands this unit a private copy
LoadCredential=arcade-key.json:/opt/barrage/secrets/arcade-key.json
Environment=ARCADE_KEY_FILE=%d/arcade-key.json
ExecStart=/opt/node/bin/node server/server.js
Restart=always
RestartSec=2
UMask=0077
LimitNOFILE=8192
TasksMax=64
MemoryMax=512M

# it only ever talks to Caddy and the node, so a compromised process can't reach the internet
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# the sandbox (no MemoryDenyWriteExecute: Node's JIT needs it)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
InaccessiblePaths=-/opt/barrage/data
InaccessiblePaths=-/opt/barrage/secrets

[Install]
WantedBy=multi-user.target
